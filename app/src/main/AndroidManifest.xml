<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SchoolSystemApplication"
        tools:targetApi="31">
        <activity
            android:name="com.example.schoolsystemapplication.ScheduleSelector"
            android:exported="false" />
        <activity
            android:name="com.example.schoolsystemapplication.AddSubject"
            android:exported="false" />
        <activity
            android:name="com.example.schoolsystemapplication.AddStudent"
            android:exported="false" />
        <activity
            android:name="com.example.schoolsystemapplication.ViewClassSchedule"
            android:exported="false" />
        <activity
            android:name="com.example.schoolsystemapplication.StudentClass_list"
            android:exported="false" />
        <activity
            android:name="com.example.schoolsystemapplication.ViewStudent"
            android:exported="false" />
        <activity
            android:name="com.example.schoolsystemapplication.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>