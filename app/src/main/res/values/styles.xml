<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base App Theme -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/blue</item>
        <item name="colorPrimaryDark">@color/blue</item>
        <item name="colorAccent">@color/blue</item>
        <item name="android:windowBackground">@color/beige</item>
    </style>

    <!-- Toolbar Style -->
    <style name="CustomToolbar">
        <item name="android:background">@color/blue</item>
        <item name="titleTextColor">@android:color/white</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="navigationIcon">@drawable/ic_menu</item>
        <item name="theme">?attr/actionBarTheme</item>
    </style>

    <style name="AssignmentDetailsToolbar">
        <item name="android:background">@color/blue</item>
        <item name="titleTextColor">@android:color/white</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="theme">?attr/actionBarTheme</item>
        <item name="title">Add Student Details</item>
    </style>

    <!-- Assignment Toolbar Style -->
    <style name="AssignmentToolbar">
        <item name="android:background">@color/blue</item>
        <item name="titleTextColor">@android:color/white</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="theme">?attr/actionBarTheme</item>
        <item name="title">ALL Assignment</item>
    </style>


    <!-- Card Style -->
    <style name="CardStyle">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">8dp</item>
        <item name="contentPadding">8dp</item>
    </style>

    <!-- Label TextView Style -->
    <style name="LabelText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/blue</item>
    </style>

    <!-- EditText Style -->
    <style name="FormEditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:background">@drawable/edittext</item>
    </style>

    <!-- Button Style -->
    <style name="PrimaryButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:backgroundTint">@color/blue</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:paddingHorizontal" tools:targetApi="26">30dp</item>
        <item name="android:paddingVertical" tools:targetApi="26">12dp</item>
    </style>

    <style name="StyledSearchView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">15dp</item>
        <item name="android:padding">7dp</item>
        <item name="android:background">@drawable/edittext</item>
    </style>

    <style name="StudentListRecyclerView">
        <item name="android:scrollbars">vertical</item>
        <item name="android:backgroundTint">@color/beige</item>
        <item name="android:divider">@android:color/transparent</item>
        <item name="android:dividerHeight">10sp</item>
    </style>
    <style name="SelectTimeButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">@color/blue</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textSize">16sp</item>
    </style>

</resources>
